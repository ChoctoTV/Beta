###############################
# ChoctoTV — Master .gitignore
###############################

##########
# Secrets
##########
.env
.env.*
secrets.txt
*.secret
*.key
*.pem
*.p12
*.keystore
*.solana
*.wallet
*.json.key
id_rsa
id_ed25519

#################
# Sensitive dirs
#################
vault/
logs/
cache/
tmp/
temp/
sessions/
backups/
crashdumps/

########################
# Workzone / Testzone
########################
workzone/
testzone/
sandbox/
localdev/

########################
# Node / TypeScript
########################
node_modules/
dist/
build/
.npm/
.npm-cache/
.pnpm-store/
bun.lockb
*.tsbuildinfo

########################
# Python
########################
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/

########################
# OS / Editor junk
########################
.DS_Store
Thumbs.db
desktop.ini

# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# JetBrains
.idea/
*.iml

########################
# Git / Repo safety
########################
*.orig
*.rej
*.patch
*.diff
*.bak
*.swp
*.swo

########################
# Build artifacts
########################
coverage/
reports/
out/
release/
bin/
obj/

########################
# Containers / Cloud
########################
docker-data/
docker-compose.override.yml
*.pid
*.sock

########################
# ChoctoTV Runtime
########################
runtime/
sessions/
userdata/
streamcache/
eventcache/
rewardcache/
